# Public URL of the deployed Express + Socket.IO server.
# Leave unset for local development; Vite proxies /socket.io to localhost:3001.
VITE_SOCKET_URL=https://your-watch-party-server.example.com

# Set this on the backend host, not in Vercel.
# CLIENT_ORIGIN=https://your-vercel-project.vercel.app
# Backend-only MongoDB and authentication configuration.
MONGODB_URI=mongodb://127.0.0.1:27017/col
JWT_SECRET=replace-this-with-a-long-random-secret
